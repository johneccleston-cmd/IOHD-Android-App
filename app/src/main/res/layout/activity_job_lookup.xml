<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFFFFF">

    <ImageView
        android:layout_width="220dp"
        android:layout_height="130dp"
        android:src="@drawable/logo"
        android:layout_marginBottom="60dp"
        android:contentDescription="Integrity Door Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SERVICE FUSION LOOKUP"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1C1E"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Job Number"
        app:boxStrokeColor="#CC0007"
        app:hintTextColor="#CC0007"
        android:textColorHint="#6B7280"
        android:layout_marginBottom="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etJobLookup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A1C1E" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLookupJob"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="FETCH DETAILS"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC0007"
        app:cornerRadius="16dp" />

    <ProgressBar
        android:id="@+id/lookupLoader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="20dp"/>

</LinearLayout>