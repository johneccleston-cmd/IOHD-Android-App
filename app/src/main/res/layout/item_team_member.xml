<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row_divider"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp">

        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_avatar_square"
            android:gravity="center"
            android:textColor="#CC0007"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/RoundedSquare" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/techNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tech Name"
            android:textColor="#1A1C1E"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/techRoleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Role"
            android:textColor="#6B7280"
            android:textSize="13.5sp" />

        <LinearLayout
            android:id="@+id/badgeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/badge5Star"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="badge5Star"
                android:src="@drawable/ic_badge_star"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/badgeNoRecalls"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="badgeNoRecalls"
                android:src="@drawable/ic_badge_shield"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/badgeLead"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="badgeLead"
                android:src="@drawable/ic_badge_crown"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/badgeTenure"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="badgeTenure"
                android:src="@drawable/ic_badge_1" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
