<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Identity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:layout_width="124dp"
                    android:layout_height="124dp">

                    <TextView
                        android:id="@+id/tvAvatarInitials"
                        android:layout_width="124dp"
                        android:layout_height="124dp"
                        android:background="@drawable/bg_avatar_square"
                        android:gravity="center"
                        android:textColor="#CC0007"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:visibility="invisible" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgUserProfilePic"
                        android:layout_width="124dp"
                        android:layout_height="124dp"
                        android:scaleType="centerCrop"
                        android:visibility="invisible"
                        app:shapeAppearanceOverlay="@style/RoundedSquare"
                        tools:src="@tools:sample/avatars" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="John Doe"
                        android:textColor="#1A1C1E"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        app:autoSizeMaxTextSize="26sp"
                        app:autoSizeMinTextSize="16sp"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:id="@+id/join_year_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Team member since 2022"
                        android:textColor="#6B7280"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvProfileRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_role_pill"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="INSTALLER"
                        android:textColor="#CC0007"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivAdminMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Admin menu"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_admin_menu"
                    android:visibility="invisible" />
            </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB" />

            <!-- Tool allowance -->
            <LinearLayout
                android:id="@+id/cardToolAllowance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tool allowance"
                            android:textColor="#1A1C1E"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvToolAllowance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$1,000 Remaining"
                            android:textColor="#CC0007"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.example.employeepos2.LiquidProgressBar
                        android:id="@+id/pbToolAllowance"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="14dp" />
                </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB" />

            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:text="Achievements"
                android:textColor="#1A1C1E"
                android:textSize="16sp"
                android:textStyle="bold" />

        

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <GridLayout
                    android:id="@+id/badgeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:rowCount="2"
                    android:useDefaultMargins="false">

                    <LinearLayout style="@style/BadgeCellNew">
                        <FrameLayout style="@style/BadgeCircleFrame">
                            <ImageView android:id="@+id/badge5Star" style="@style/BadgeIconNew" android:src="@drawable/ic_badge_star" />
                        </FrameLayout>
                        <TextView style="@style/BadgeLabelNew" android:text="5-Star" />
                    </LinearLayout>

                    <LinearLayout style="@style/BadgeCellNew">
                        <FrameLayout style="@style/BadgeCircleFrame">
                            <ImageView android:id="@+id/badgeNoRecalls" style="@style/BadgeIconNew" android:src="@drawable/ic_badge_shield" />
                        </FrameLayout>
                        <TextView style="@style/BadgeLabelNew" android:text="No Recalls" />
                    </LinearLayout>

                    <LinearLayout style="@style/BadgeCellNew">
                        <FrameLayout style="@style/BadgeCircleFrame">
                            <ImageView android:id="@+id/badgeLeadTech" style="@style/BadgeIconNew" android:src="@drawable/ic_badge_crown" />
                        </FrameLayout>
                        <TextView style="@style/BadgeLabelNew" android:text="Lead Tech" />
                    </LinearLayout>

                    <LinearLayout style="@style/BadgeCellNew">
                        <FrameLayout style="@style/BadgeCircleFrame">
                            <ImageView android:id="@+id/badge1Year" style="@style/BadgeIconNew" android:src="@drawable/ic_badge_1" />
                        </FrameLayout>
                        <TextView style="@style/BadgeLabelNew" android:text="1 Year" />
                    </LinearLayout>

                    <LinearLayout style="@style/BadgeCellNew">
                        <FrameLayout style="@style/BadgeCircleFrame">
                            <ImageView android:id="@+id/badge2Year" style="@style/BadgeIconNew" android:src="@drawable/ic_badge_2" />
                        </FrameLayout>
                        <TextView style="@style/BadgeLabelNew" android:text="2 Years" />
                    </LinearLayout>

                    <LinearLayout style="@style/BadgeCellNew">
                        <FrameLayout style="@style/BadgeCircleFrame">
                            <ImageView android:id="@+id/badge3Year" style="@style/BadgeIconNew" android:src="@drawable/ic_badge_3" />
                        </FrameLayout>
                        <TextView style="@style/BadgeLabelNew" android:text="3 Years" />
                    </LinearLayout>

                    <LinearLayout style="@style/BadgeCellNew">
                        <FrameLayout style="@style/BadgeCircleFrame">
                            <ImageView android:id="@+id/badge4Year" style="@style/BadgeIconNew" android:src="@drawable/ic_badge_4" />
                        </FrameLayout>
                        <TextView style="@style/BadgeLabelNew" android:text="4 Years" />
                    </LinearLayout>

                    <LinearLayout style="@style/BadgeCellNew">
                        <FrameLayout style="@style/BadgeCircleFrame">
                            <ImageView android:id="@+id/badge5Year" style="@style/BadgeIconNew" android:src="@drawable/ic_badge_5" />
                        </FrameLayout>
                        <TextView style="@style/BadgeLabelNew" android:text="5 Years" />
                    </LinearLayout>

                </GridLayout>
            </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyDocuments"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#CC0007"
                android:text="My documents"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="Log out"
                android:textAllCaps="false"
                android:textColor="#4B5563"
                android:textSize="15.5sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:elevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Admin drawer -->
    <LinearLayout
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="ADMIN TOOLS"
            android:textColor="#CC0007"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Management"
            android:textColor="#1A1C1E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="18dp"
            android:background="#E5E7EB" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSideMasterSchedule"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:text="Company schedule"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#CC0007"
            app:iconTint="#FFFFFF"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSideTeamCommissions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:text="Team commissions"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            app:backgroundTint="#FFFFFF"
            app:iconTint="#6B7280"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_money2"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSideTeamToolAllowance"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:text="Team tool allowance"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            app:backgroundTint="#FFFFFF"
            app:iconTint="#6B7280"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:icon="@android:drawable/ic_menu_manage"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="18dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
