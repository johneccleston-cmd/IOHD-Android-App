<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sectionConcreteDetails"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="visible">

    <View android:layout_width="match_parent" android:layout_height="8dp" android:background="#F1F5F9" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="32dp" android:gravity="start" android:paddingHorizontal="20dp" android:letterSpacing="0.1" android:text="CONCRETE MEASUREMENTS" android:textColor="#CC0007" android:textSize="12sp" android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="0dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:strokeColor="#E5E7EB" android:layout_marginBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:gravity="center" android:text="LEFT SIDE CUTOUT ISLO" android:textColor="#1A1C1E" android:textSize="16sp" android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginBottom="16dp" android:background="#FFFFFF">
                <ImageView android:id="@+id/imgConcreteLeft" android:layout_width="0dp" android:layout_height="0dp" android:scaleType="fitCenter" android:src="@drawable/concrete_template" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="1.0" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="1.0" />
                <com.example.employeepos2.MeasurementOverlayView android:id="@+id/overlayConcreteLeft" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
                <EditText android:id="@+id/etConcreteDepthLeft" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/input_box_outline" android:gravity="center" android:hint="Depth" android:inputType="number" android:textColor="#1A1C1E" android:textColorHint="#6B7280" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.173" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.388" />
                <EditText android:id="@+id/etConcreteWidthLeft" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/input_box_outline" android:gravity="center" android:hint="Width" android:inputType="number" android:textColor="#1A1C1E" android:textColorHint="#6B7280" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.672" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.234" />
                <EditText android:id="@+id/etConcreteLengthLeft" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/input_box_outline" android:gravity="center" android:hint="Length" android:inputType="number" android:textColor="#1A1C1E" android:textColorHint="#6B7280" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.404" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.696" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginVertical="16dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:gravity="center" android:text="RIGHT SIDE CUTOUT ISLO" android:textColor="#1A1C1E" android:textSize="16sp" android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginBottom="24dp" android:background="#FFFFFF">
                <ImageView android:id="@+id/imgConcreteRight" android:layout_width="0dp" android:layout_height="0dp" android:scaleType="fitCenter" android:scaleX="-1" android:src="@drawable/concrete_template" android:visibility="visible" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

                <com.example.employeepos2.MeasurementOverlayView
                    android:id="@+id/overlayConcreteRight"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleX="-1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText android:id="@+id/etConcreteDepthRight" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/input_box_outline" android:gravity="center" android:hint="Depth" android:inputType="number" android:textColor="#1A1C1E" android:textColorHint="#6B7280" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.827" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.388" />
                <EditText android:id="@+id/etConcreteWidthRight" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/input_box_outline" android:gravity="center" android:hint="Width" android:inputType="number" android:textColor="#1A1C1E" android:textColorHint="#6B7280" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.328" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.234" />
                <EditText android:id="@+id/etConcreteLengthRight" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/input_box_outline" android:gravity="center" android:hint="Length" android:inputType="number" android:textColor="#1A1C1E" android:textColorHint="#6B7280" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.596" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_bias="0.696" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB" android:layout_marginBottom="16dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Is concrete ready for install?" android:textColor="#1A1C1E" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup android:id="@+id/rgConcreteReady" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" android:layout_marginBottom="16dp">
                <com.google.android.material.chip.Chip android:id="@+id/rbConcreteYes" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yes" />
                <com.google.android.material.chip.Chip android:id="@+id/rbConcreteNoTrack" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No, interferes with track only" />
                <com.google.android.material.chip.Chip android:id="@+id/rbConcreteNoTrackBottom" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No, interferes with track and bottom section" />
            </com.google.android.material.chip.ChipGroup>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F3F4F6" android:layout_marginBottom="16dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Concrete notes:" android:textSize="14sp" android:textColor="#1A1C1E" android:textStyle="bold" android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Add concrete notes..." android:textColorHint="#6B7280" app:hintTextColor="#CC0007" app:boxStrokeColor="@color/login_box_stroke" app:boxCornerRadiusBottomEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusTopStart="12dp" app:boxBackgroundColor="#FFFFFF" android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etConcreteNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:minLines="2" android:textColor="#1A1C1E" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="* Upload photo of concrete left side and right side" android:textSize="12sp" android:textStyle="italic" android:textColor="#CC0007" android:layout_marginBottom="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConcretePhoto" android:layout_width="match_parent" android:layout_height="48dp" android:text="ATTACH CONCRETE PHOTO" android:textColor="#CC0007" android:backgroundTint="#FFFFFF" app:strokeColor="#CC0007" app:strokeWidth="0dp" app:cornerRadius="12dp" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none" android:overScrollMode="never">
                <LinearLayout android:id="@+id/llConcretePhotos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>