<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:paddingHorizontal="0dp"
    android:background="@drawable/bg_row_divider">

    <CheckBox
        android:id="@+id/cbPicked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#CC0007"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvPartName"
        app:layout_constraintBottom_toBottomOf="@id/tvPartName" />

    <TextView
        android:id="@+id/tvPartName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:text="Part Name"
        android:textColor="#1A1C1E"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/cbPicked"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvPartDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Description text"
        android:textColor="#6B7280"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/tvPartName"
        app:layout_constraintEnd_toEndOf="@id/tvPartName"
        app:layout_constraintTop_toBottomOf="@id/tvPartName"/>

    <TextView
        android:id="@+id/tvStockLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_stock_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="-- In Stock"
        android:textColor="#15803D"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvPartName"
        app:layout_constraintTop_toBottomOf="@id/tvPartDescription"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <LinearLayout
        android:id="@+id/qtyContainer"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@drawable/bg_spinner_field"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvStockLevel"
        app:layout_constraintBottom_toBottomOf="@id/tvStockLevel">

        <TextView
            android:id="@+id/btnMinusPartQty"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="−"
            android:textColor="#CC0007"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>

        <EditText
            android:id="@+id/etPartQty"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="center"
            android:inputType="number"
            android:text="1"
            android:textColor="#CC0007"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnPlusPartQty"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+"
            android:textColor="#CC0007"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>