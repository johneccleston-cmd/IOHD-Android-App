<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CYCLE COUNTS"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="#AAAAAA"
            android:layout_marginTop="24dp" />

        <!-- FRIDAY SCHEDULE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCHEDULE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="#CC0007" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="4">

                    <!-- 1st Friday / Zone 1 -->
                    <LinearLayout
                        android:id="@+id/llSchedule1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tvScheduleTitle1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1st Friday"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#111111" />

                        <TextView
                            android:id="@+id/tvScheduleSub1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zone 1"
                            android:textSize="11sp"
                            android:textColor="#777777"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- 2nd Friday / Zone 2 -->
                    <LinearLayout
                        android:id="@+id/llSchedule2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tvScheduleTitle2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2nd Friday"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#111111" />

                        <TextView
                            android:id="@+id/tvScheduleSub2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zone 2"
                            android:textSize="11sp"
                            android:textColor="#777777"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- 3rd Friday / Zone 3 -->
                    <LinearLayout
                        android:id="@+id/llSchedule3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tvScheduleTitle3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3rd Friday"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#111111" />

                        <TextView
                            android:id="@+id/tvScheduleSub3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zone 3"
                            android:textSize="11sp"
                            android:textColor="#777777"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- 4th Friday / Zone 4 -->
                    <LinearLayout
                        android:id="@+id/llSchedule4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:id="@+id/tvScheduleTitle4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4th Friday"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#111111" />

                        <TextView
                            android:id="@+id/tvScheduleSub4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zone 4"
                            android:textSize="11sp"
                            android:textColor="#777777"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EBEBEB"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- ZONE 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZone1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_red">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#CC0007" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zone 1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111111" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Doors, Struts, Shafts\n• Op Heads, Rails, Parts\n• Remotes, Keypads, Photo Eyes"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- 🔥 BLACK LAST COUNT LABEL -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Count"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textAllCaps="true"/>

                    <TextView
                        android:id="@+id/tvDateZone1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Never"
                        android:textSize="12sp"
                        android:textColor="#CC0007"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvStatusZone1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#CC0007"
                        android:visibility="gone"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ZONE 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZone2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_red">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="2"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#CC0007" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zone 2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111111" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Weatherseal, Bolts\n• Springs, Doors\n• Punched Angle"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- 🔥 BLACK LAST COUNT LABEL -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Count"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textAllCaps="true"/>

                    <TextView
                        android:id="@+id/tvDateZone2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Never"
                        android:textSize="12sp"
                        android:textColor="#CC0007"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvStatusZone2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#CC0007"
                        android:visibility="gone"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ZONE 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZone3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_red">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="3"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#CC0007" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zone 3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111111" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Doors, Tracks (Horiz/Vert)\n• Operator Heads\n• Operator Rails"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- 🔥 BLACK LAST COUNT LABEL -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Count"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textAllCaps="true"/>

                    <TextView
                        android:id="@+id/tvDateZone3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Never"
                        android:textSize="12sp"
                        android:textColor="#CC0007"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvStatusZone3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#CC0007"
                        android:visibility="gone"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ZONE 4 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZone4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_red">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="4"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#CC0007" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zone 4"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#111111" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Doors, Bearings, Brackets\n• Cables, Couplers, Drums\n• Plates, Hinges, Rollers, etc."
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <!-- 🔥 BLACK LAST COUNT LABEL -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Count"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textAllCaps="true"/>

                    <TextView
                        android:id="@+id/tvDateZone4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Never"
                        android:textSize="12sp"
                        android:textColor="#CC0007"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvStatusZone4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#CC0007"
                        android:visibility="gone"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>